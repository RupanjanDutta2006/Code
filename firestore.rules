rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isClassOwner(classId) {
      return isSignedIn() && exists(/databases/$(database)/documents/classrooms/$(classId)) && (
        get(/databases/$(database)/documents/classrooms/$(classId)).data.owner_id == request.auth.uid ||
        get(/databases/$(database)/documents/classrooms/$(classId)).data.ownerUid == request.auth.uid
      );
    }

    function isClassMember(classId) {
      return isSignedIn() && (
        isClassOwner(classId) ||
        exists(/databases/$(database)/documents/classrooms/$(classId)/members/$(request.auth.uid))
      );
    }

    // User profiles & bidirectional user classroom references
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isUser(uid);

      match /classrooms/{classId} {
        allow read, write: if isUser(uid);
      }
    }

    // Fast O(1) Access key lookup registry
    match /classAccessKeys/{key} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isClassOwner(resource.data.classroomId));
    }

    // Classrooms collection
    match /classrooms/{classId} {
      // Allow reading classroom metadata for authenticated users / join resolution
      allow read: if isSignedIn();
      
      // Only authenticated users can create classrooms as owner
      allow create: if isSignedIn() && (
        request.resource.data.owner_id == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
      
      // Owner can edit settings or delete classroom; members can increment member_count on join
      allow update: if isSignedIn() && (
        isClassOwner(classId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_count', 'updated_at', 'resource_count', 'assignment_count', 'announcement_count'])
      );
      allow delete: if isClassOwner(classId);

      // Members subcollection
      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (isClassOwner(classId) || request.auth.uid == memberUid);
        allow update, delete: if isClassOwner(classId) || (isSignedIn() && request.auth.uid == memberUid);
      }

      // Announcements subcollection: members read, owner manages
      match /announcements/{announcementId} {
        allow read: if isClassMember(classId);
        allow write, delete: if isClassOwner(classId);
      }

      // Resources & Notes subcollection: members read, owner manages
      match /resources/{resourceId} {
        allow read: if isClassMember(classId);
        allow write, delete: if isClassOwner(classId);
      }

      // Study Library subcollection: members read, owner manages
      match /library/{resourceId} {
        allow read: if isClassMember(classId);
        allow write, delete: if isClassOwner(classId);
      }

      // Assignments subcollection: members read, owner manages
      match /assignments/{assignmentId} {
        allow read: if isClassMember(classId);
        allow write, delete: if isClassOwner(classId);

        // Submissions subcollection under assignments
        match /submissions/{studentUid} {
          allow read: if isClassOwner(classId) || isUser(studentUid);
          allow create, update: if isUser(studentUid) || isClassOwner(classId);
          allow delete: if isClassOwner(classId);
        }
      }
    }

    // Secure Audit Logs: client cannot create, edit or delete audit logs directly
    match /auditLogs/{logId} {
      allow create, update, delete: if false;
      allow read: if isSignedIn() && (request.auth.token.admin == true || resource.data.actorUid == request.auth.uid);
    }
  }
}