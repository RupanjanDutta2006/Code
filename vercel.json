{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/execute",
      "destination": "/api/execute"
    },
    {
      "source": "/api/run",
      "destination": "/api/run"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/playground",
      "destination": "/api/playground"
    },
    {
      "source": "/api/ai/:match*",
      "destination": "/api/ai/:match*"
    },
    {
      "source": "/api/programs/execute",
      "destination": "/api/programs/execute"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?match=:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
