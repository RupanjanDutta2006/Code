# =========================================================
# CodeVault Pro — Server-Side Environment Variables Template
# Copy this file to .env or configure in Vercel / Cloud Dashboard.
# NEVER commit real API keys or credentials to version control.
# =========================================================

# Backend Server Configuration
PORT=8000
SECRET_KEY=
DATABASE_URL=sqlite:///data/codevault.db

# Online AI Provider Credentials (Server-Side ONLY)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_REASONING_BUDGET=16384
NVIDIA_ENABLE_THINKING=true
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096

# Optional Fallback Providers (Server-Side ONLY)
GEMINI_API_KEY=
OPENAI_API_KEY=
