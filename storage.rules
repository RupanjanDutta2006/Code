rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Classroom notes and materials
    match /classrooms/{classId}/notes/{allPaths=**} {
      // Authenticated users can read classroom notes
      allow read: if isSignedIn();

      // Only authenticated users with reasonable file size can upload (< 50MB)
      allow write: if isSignedIn() 
        && request.resource.size < 50 * 1024 * 1024;

      // Allow deletion by authenticated users
      allow delete: if isSignedIn();
    }

    // Classroom assignments and attachments
    match /classrooms/{classId}/assignments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write, delete: if isSignedIn() && request.resource.size < 50 * 1024 * 1024;
    }

    // User avatars
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write, delete: if isSignedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
