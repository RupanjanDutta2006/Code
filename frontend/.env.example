# CodeVault Pro - Frontend Environment Variables

# Backend API URL (Leave blank for local development proxy /api)
# In production on Vercel, set this in Vercel Project Settings -> Environment Variables
VITE_API_URL=https://codevault-backend.onrender.com

# Backend WebSocket URL (Leave blank for local development proxy /ws)
# In production on Vercel, set this in Vercel Project Settings -> Environment Variables
VITE_WS_URL=wss://codevault-backend.onrender.com
